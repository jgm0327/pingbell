# Copy this file to `.env` and fill in real values before running `docker compose up -d`
# or `.\gradlew.bat bootRun`. Never commit the real `.env` — it is already gitignored.

POSTGRES_DB=pingbell
POSTGRES_USER=pingbell
POSTGRES_PASSWORD=pingbell1234!!
# Used only when running the backend directly on the host (see README "3. 백엔드를 Docker
# 없이 로컬에서 직접 실행"). The `app` service in docker-compose.yml overrides this to the
# in-network service name (`postgres`) regardless of this value.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=change-this-to-a-long-random-secret
JWT_REFRESH_TOKEN_EXPIRATION_MS=1209600000
JWT_REMEMBER_ME_REFRESH_TOKEN_EXPIRATION_MS=2592000000
NOTIFICATION_TARGET_ENCRYPTION_KEY=change-this-to-a-long-random-notification-target-key

# Local default: Mailpit (docker compose up -d mailpit), not a real SMTP server.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS_ENABLE=false

MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

KAFKA_PORT=9092
# Used only when running the backend directly on the host. Inside docker-compose the `app`
# service always uses `kafka:29092` (the internal listener) instead.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
PINGBELL_CHECK_DISPATCH_MODE=direct
PINGBELL_KAFKA_CONSUMER_GROUP_ID=pingbell-check-worker
PINGBELL_NOTIFICATION_WORKER_GROUP_ID=pingbell-notification-worker
PINGBELL_KAFKA_TOPIC_HEALTH_CHECK_REQUESTED=pingbell.health-check.requested
PINGBELL_KAFKA_TOPIC_HEALTH_CHECK_COMPLETED=pingbell.health-check.completed
PINGBELL_KAFKA_TOPIC_NOTIFICATION_REQUESTED=pingbell.notification.requested

# AI log analysis (see docs/agents/ai-agent.md). Leave the API key blank to run everything
# else without AI features; log analysis requests will fail with LOG_ANALYSIS_AI_UNAVAILABLE.
LOG_ANALYSIS_AI_API_KEY=
LOG_ANALYSIS_AI_BASE_URL=https://api.openai.com/v1/
LOG_ANALYSIS_AI_MODEL=gpt-4o-mini
LOG_ANALYSIS_AI_TIMEOUT_SECONDS=60
# Optional Runbook RAG context tuning — all have sane defaults in application.yml.
# LOG_ANALYSIS_RUNBOOK_ENABLED=true
# LOG_ANALYSIS_RUNBOOK_TOP_K=3
# LOG_ANALYSIS_RUNBOOK_MINIMUM_RELEVANCE=0.5
# LOG_ANALYSIS_RUNBOOK_MAX_CONTEXT_CHUNKS=3
# LOG_ANALYSIS_RUNBOOK_MAX_CONTEXT_CHARACTERS=6000
# LOG_ANALYSIS_RUNBOOK_MAX_QUERY_CHARACTERS=4000

# docker-compose `app` service host port (defaults to 8080 if unset).
# APP_PORT=8080

# Used by the H2-backed `test` Spring profile / Testcontainers-backed migration tests only.
TEST_POSTGRES_DB=test
